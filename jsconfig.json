{
	"compilerOptions": {
		"target": "es2017",
		"module": "esnext",
		"moduleResolution": "Bundler",
		"lib": ["es2017", "dom"],

		"strict": false,
		"checkJs": true,
		"allowSyntheticDefaultImports": true,

		"paths": {
			"@effekseer": ["./lib/effekseer/effekseer.js"],
			"@vorbis": ["./lib/vorbisdecoder.js"]
		},
		"outDir": "dist",
		"types": ["pixi.js", "nw.js", "chrome", "localforage"]
	},
	"include": [
		"src",
		"lib/effekseer/effekseer.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}