{
	"name": "rmmz",
	"version": "1.10.0",
	"type": "module",
	"devDependencies": {
		"@types/chrome": "^0.3.7",
		"@types/nw.js": "^0.115.0",
		"esbuild": "^0.28.2"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"dependencies": {
		"localforage": "^1.10.0",
		"pako": "^1.0.11",
		"pixi.js": "^5.3.12"
	},
	"scripts": {
		"start": "pnpm build && nw .",
		"build": "node esbuild.config.mjs && pnpm build:pixi",
		"watch": "node esbuild.config.mjs --watch",
		"build:pixi": "esbuild pixi.js --bundle --minify --global-name=PIXI --outfile=./dist/pixi.js"
	},
	"main": "index.html",
	"chromium-args": "--force-color-profile=srgb --auto-open-devtools-for-tabs",
	"window": {
		"title": "Project1",
		"width": 816,
		"height": 624,
		"position": "center",
		"icon": "./assets/icon/icon.png"
	}
}
