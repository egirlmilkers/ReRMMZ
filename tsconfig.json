{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"allowJs": true,
		"checkJs": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"]
	},
	"include": ["src/**/*", "types/**/*"]
}
